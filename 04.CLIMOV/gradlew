#!/bin/sh

DIRNAME=$(dirname "$0")
APP_HOME=$(cd "${DIRNAME}/" >/dev/null 2>&1; pwd -P)

CLASSPATH="${APP_HOME}/gradle/wrapper/gradle-wrapper.jar"

JAVA_HOME="${ANDROID_STUDIO_JAVA_HOME:-/opt/android-studio/jbr}"
JAVA_EXEC="${JAVA_HOME}/bin/java"

exec "${JAVA_EXEC}" \
    -Xmx64m -Xms64m \
    -classpath "${CLASSPATH}" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
